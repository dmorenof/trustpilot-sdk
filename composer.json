{
    "name": "dmorenof/trustpilot-sdk",
    "description": "Unofficial PHP SDK for the Trustpilot Business Units and Reviews APIs.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/dmorenof/trustpilot-sdk",
    "keywords": [
        "sdk",
        "api-client",
        "php",
        "openapi",
        "sdk-runtime"
    ],
    "authors": [
        {
            "name": "David Moreno Falero",
            "role": "Developer"
        }
    ],
    "require": {
        "dmorenof/sdk-runtime": "^1.14.1",
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "TrustpilotSDK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SdkTests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml",
        "analyse": "phpstan analyse --no-progress --memory-limit=-1"
    }
}
